[node name="Grimoire" parent="." unique_id=418822901 instance=ExtResource("18_grim")]
transform = Transform3D(0.990268, 0, -0.139173, 0, 1, 0, 0.139173, 0, 0.990268, 11.05, 4.395, -13.72)
prompt = "The open book"
examine_lines = Array[String](["It is open, and it is warm.", "Nothing else in this house is warm."])
passages = Array[String](["The hand is not the same on every page. Two people wrote this, and the second one was in a hurry.", "\"The house keeps what it is given. Give it something it wants and it will open a door for you.\"", "\"Three figures, taken from three of its own things. It will not answer to a number you simply guessed.\"", "The last entry is a single line, pressed so hard the nib went through: \"Do not go up after dark.\""])
