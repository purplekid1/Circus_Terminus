[ext_resource type="Script" path="res://Scripts/Ambience.gd" id="amb"]
[ext_resource type="AudioStream" path="res://Audio/amb_outside.mp3" id="bed_out"]
[ext_resource type="AudioStream" path="res://Audio/amb_house.mp3" id="bed_house"]
[ext_resource type="AudioStream" path="res://Audio/amb_cellar.mp3" id="bed_cellar"]

