[gd_scene load_steps=10 format=3]

; A knife switch the size of a fire axe, bolted to the wall beside the big top
; door. Uses Scripts/Lever.gd unchanged -- it already turns a Handle node and
; drives targets by NodePath, which is exactly this.
;
; MOUNTED LOW ON PURPOSE. Everything else in this fairground is built for
; something three metres tall and is therefore out of reach, which is the whole
; joke of the place. This one thing is not: it is the switch the player has to
; be able to hit, so it sits at chest height and reads as the one piece of the
; machinery that was ever meant for someone their size.

[ext_resource type="Script" path="res://Scripts/Lever.gd" id="1_lever"]
[ext_resource type="Material" path="res://Materials/Mat_rust.tres" id="2_rust"]
[ext_resource type="Material" path="res://Materials/Mat_iron.tres" id="3_iron"]
[ext_resource type="Material" path="res://Materials/Mat_taillamp.tres" id="4_red"]

[sub_resource type="BoxMesh" id="Mesh_back"]
size = Vector3(1.3, 1.9, 0.28)

[sub_resource type="BoxMesh" id="Mesh_guard"]
size = Vector3(1.5, 0.22, 0.5)

[sub_resource type="CylinderMesh" id="Mesh_rod"]
top_radius = 0.075
bottom_radius = 0.09
height = 1.05

[sub_resource type="BoxMesh" id="Mesh_knob"]
size = Vector3(0.3, 0.3, 0.3)

[sub_resource type="BoxShape3D" id="Shape_switch"]
size = Vector3(1.5, 2.1, 0.55)

[node name="WallSwitch" type="Node3D" groups=["interactable"]]
script = ExtResource("1_lever")
prompt = "switch"
on_angle = 52.0
off_angle = 128.0
throw_time = 0.18

[node name="Back" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_back")
surface_material_override/0 = ExtResource("2_rust")

; A hood over the top, so the switch reads as something that matters rather
; than as a box screwed to a wall.
[node name="Guard" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.02, 0.18)
mesh = SubResource("Mesh_guard")
surface_material_override/0 = ExtResource("3_iron")

; Generous across the face, so a player running at this in the dark does not
; have to be precise with a 2.6 m ray -- but NOT generous in depth.
;
; It used to be 1.1 m deep and pushed 0.4 m forward, which put half a metre of
; invisible wall in the air in front of the switch. You walked into nothing,
; on the approach to the only door out of the level. Depth now matches the
; hood, and the box sits on the plate rather than floating off it.
[node name="Body" type="StaticBody3D" parent="."]

[node name="Shape" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.16)
shape = SubResource("Shape_switch")

[node name="Handle" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.35, 0.2)

[node name="Rod" type="MeshInstance3D" parent="Handle"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
mesh = SubResource("Mesh_rod")
surface_material_override/0 = ExtResource("3_iron")

[node name="Knob" type="MeshInstance3D" parent="Handle"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.06, 0)
mesh = SubResource("Mesh_knob")
surface_material_override/0 = ExtResource("4_red")
