; THE TALLY SHEET. The mansion already asked for this by NodePath -- the
; bureau's `reveals` pointed at "Lid/TallyClue" -- and no such node existed, so
; opening the bureau revealed nothing and the one page that explains how to
; read the portraits was unreachable. The safe was unopenable by fair means.
;
; Starts hidden and disabled; Cabinet.interact turns both on. Its text is
; written at runtime by Scripts/SafeCode.gd, because the combination is rolled
; fresh every playthrough and this is the page that explains it.
;
; No lens needed: this is a full sheet of paper in normal handwriting, and the
; step it is teaching is the ordering, not the reading. The fine print is on
; the plaques.
[node name="TallyClue" type="Node3D" parent="Lid"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.6, -0.16, 0.08)
visible = false
script = ExtResource("2_clue")
prompt = "A tally, in a careful hand"
enabled = false
requires_lens = false
seconds_on_screen = 11.0

[node name="Body" type="StaticBody3D" parent="Lid/TallyClue"]

[node name="Shape" type="CollisionShape3D" parent="Lid/TallyClue/Body"]
shape = SubResource("Box_tally")

[node name="Paper" type="MeshInstance3D" parent="Lid/TallyClue"]
mesh = SubResource("Mesh_tally")
material_override = SubResource("Mat_tally")
